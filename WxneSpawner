-- ==================== MENÚ HACKER ====================
function CreateHackerMenu()
    -- Tab Principal Auto Farm
    local MainTab = Window:CreateTab("🧠 Auto Farm", 4483362458)

    MainTab:CreateSection("Farmeo Automático")

    MainTab:CreateToggle({
        Name = "Auto Recoger Brainrots",
        CurrentValue = false,
        Callback = function(Value)
            AutoCollectActive = Value
            if Value then
                Rayfield:Notify({Title = "🧠 Activado", Content = "Auto Recolección activada", Duration = 3})
                AutoCollectBrainrots()
            end
        end
    })

    MainTab:CreateToggle({
        Name = "Auto Farm (TP a Brainrots)",
        CurrentValue = false,
        Callback = function(Value)
            AutoFarmActive = Value
            if Value then
                Rayfield:Notify({Title = "⚡ Activado", Content = "Auto Farm activado", Duration = 3})
                AutoFarmBrainrots()
            end
        end
    })

    MainTab:CreateSlider({
        Name = "Velocidad de Farm",
        Range = {0.1, 2},
        Increment = 0.1,
        CurrentValue = 0.5,
        Callback = function(Value)
            FarmSpeed = Value
        end
    })

    MainTab:CreateButton({
        Name = "🎯 TP al Spawn de Brainrots",
        Callback = function() TeleportToSpawn() end
    })

    MainTab:CreateButton({
        Name = "🧲 Traer Todos los Brainrots",
        Callback = function() BringAllBrainrots() end
    })

    -- Tab Teleports
    local TPTab = Window:CreateTab("🌍 Teleports", 4483362458)
    TPTab:CreateButton({Name = "🏪 TP a Tienda", Callback = function() TeleportToShop() end})
    TPTab:CreateButton({Name = "💰 TP a Zona de Venta", Callback = function() TeleportToSell() end})

    -- Tab Exploits
    local ExploitTab = Window:CreateTab("⚡ Exploits", 4483362458)

    ExploitTab:CreateSlider({
        Name = "Velocidad de Movimiento",
        Range = {16, 200},
        Increment = 1,
        CurrentValue = 16,
        Callback = function(Value)
            local hum = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid")
            if hum then hum.WalkSpeed = Value end
        end
    })

    ExploitTab:CreateToggle({
        Name = "Noclip (Atravesar Paredes)",
        CurrentValue = false,
        Callback = function(Value)
            NoclipEnabled = Value
            if Value then StartNoclip() end
        end
    })

    ExploitTab:CreateToggle({
        Name = "Capacidad Infinita",
        CurrentValue = false,
        Callback = function(Value)
            if Value then EnableInfiniteCapacity() end
        end
    })

    -- Tab Visual
    local VisualTab = Window:CreateTab("👁️ Visual", 4483362458)
    VisualTab:CreateButton({Name = "💡 Fullbright", Callback = EnableFullbright})

    Rayfield:Notify({Title = "✅ Menú Cargado", Content = "Disfruta del script", Duration = 5})
end

-- ==================== FUNCIONES ====================

local FarmSpeed = 0.5
local NoclipEnabled = false

function AutoCollectBrainrots()
    spawn(function()
        while AutoCollectActive do
            for _, item in pairs(workspace:GetDescendants()) do
                if item:IsA("Model") and (item.Name:lower():find("brainrot") or item.Name:lower():find("rot")) then
                    local target = item:FindFirstChild("Handle") or item:FindFirstChild("HumanoidRootPart")
                    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if target and root then
                        firetouchinterest(root, target, 0)
                        task.wait(0.1)
                        firetouchinterest(root, target, 1)
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

function AutoFarmBrainrots()
    spawn(function()
        while AutoFarmActive do
            for _, item in pairs(workspace:GetDescendants()) do
                if not AutoFarmActive then break end
                if item:IsA("Model") and (item.Name:lower():find("brainrot") or item.Name:lower():find("rot")) then
                    local target = item:FindFirstChild("Handle") or item:FindFirstChild("HumanoidRootPart")
                    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if target and root then
                        root.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                        task.wait(FarmSpeed)
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

function BringAllBrainrots()
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local count = 0
    for _, item in pairs(workspace:GetDescendants()) do
        if item:IsA("Model") and (item.Name:lower():find("brainrot") or item.Name:lower():find("rot")) then
            local target = item:FindFirstChild("Handle") or item:FindFirstChild("HumanoidRootPart")
            if target then
                target.CFrame = root.CFrame
                count += 1
            end
        end
    end

    Rayfield:Notify({Title = "🧲 Listo", Content = "Se trajeron " .. count .. " brainrots", Duration = 4})
end

function TeleportToSpawn()
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local spawn = workspace:FindFirstChild("SpawnLocation") or workspace:FindFirstChild("Spawn")
    if root and spawn then
        root.CFrame = spawn.CFrame + Vector3.new(0, 5, 0)
    end
end

function TeleportToShop()
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local shop = workspace:FindFirstChild("Shop", true) or workspace:FindFirstChild("Store", true)
    if root and shop then
        root.CFrame = shop:GetPivot() + Vector3.new(0, 5, 0)
    end
end

function TeleportToSell()
    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local sell = workspace:FindFirstChild("SellZone") or workspace:FindFirstChild("Sell")
    if root and sell then
        root.CFrame = sell:GetPivot() + Vector3.new(0, 5, 0)
    end
end

function StartNoclip()
    spawn(function()
        while NoclipEnabled do
            local char = game.Players.LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            task.wait()
        end
        -- Restaurar colisiones al desactivar
        local char = game.Players.LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end)
end

function EnableInfiniteCapacity()
    spawn(function()
        while task.wait(1) do
            local leaderstats = game.Players.LocalPlayer:FindFirstChild("leaderstats")
            if leaderstats then
                for _, stat in pairs(leaderstats:GetChildren()) do
                    if stat.Name:lower():find("capacity") or stat.Name:lower():find("capacidad") then
                        stat.Value = math.huge
                    end
                end
            end
        end
    end)
end

function EnableFullbright()
    local lighting = game:GetService("Lighting")
    lighting.Brightness = 2
    lighting.ClockTime = 14
    lighting.FogEnd = 100000
    lighting.GlobalShadows = false
    lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Rayfield:Notify({Title = "💡 Fullbright", Content = "Activado correctamente", Duration = 3})
end

